# Revora Backend Environment Variables
# Copy this file to .env and fill in your values

# App Settings
APP_NAME=Revora
APP_ENV=development
REVIEW_WORKER_CONCURRENCY=5

# Security (REQUIRED)
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Generate JWT_SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
ENCRYPTION_KEY=your_fernet_key_here

# Database (REQUIRED)
DATABASE_URL=postgresql+asyncpg://revora:changeme@localhost:5432/revora_db

# Redis (optional)
# REDIS_URL=redis://localhost:6379/0

# GitHub OAuth (REQUIRED for login)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub App (REQUIRED for repository access)
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# LLM API Keys (at least one required)
GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key

# CORS (defaults to localhost:3000-3002)
# In development any localhost/127.0.0.1 port is allowed automatically.
# For production set an explicit list of frontend origins. Never use "*"
# with credentials.
# CORS_ORIGINS=["https://app.example.com"]
# Optional regex for additional allowed origins (advanced). Leave unset
# in production unless you know what you are doing.
# CORS_ORIGIN_REGEX=^https://.*\.example\.com$

# MouthMap Model Lab (inference-only, private Hugging Face Gradio Space)
# Configure via environment (Render dashboard in prod, backend/.env locally).
# The token is a Bearer secret: server-side only, never logged or exposed.
MOUTHMAP_HF_ENDPOINT_URL=https://<your-space>.hf.space
MOUTHMAP_HF_API_TOKEN=
MOUTHMAP_MAX_UPLOAD_MB=50
MOUTHMAP_MODEL_VERSION=mouthmap-v1
# Inference resource guards (Render Free 512MB tuned values shown)
MOUTHMAP_HF_TIMEOUT_S=180
MOUTHMAP_UPLOAD_TIMEOUT_S=60
MOUTHMAP_MAX_CONCURRENT_INFERENCES=1

# kLLM managed local inference (server-owned provider)
# Disabled by default. Enabling needs BOTH this flag AND an admin enabling
# the seeded `kllm` provider in Settings -> Providers (or Admin -> Providers).
# Local requests to 127.0.0.1 need no gateway key. The URL and key are
# server-side only and are never returned by the API.
KLLM_ENABLED=false
KLLM_SERVER_URL=http://127.0.0.1:8080
# KLLM_GATEWAY_API_KEY=
# KLLM_STATE_TIMEOUT_S=8
# KLLM_TELEMETRY_TIMEOUT_S=5

# Hosted Ollama (Revora-managed remote inference, Chat only)
# A separate provider from kLLM. Disabled by default. Enabling needs BOTH this
# flag AND the admin "Hosted models" selection toggle. Only runtime-loaded
# models (/api/ps) are exposed; Revora never auto-loads a model just to list it.
# The base URL and token are server-side only and are never returned by the API.
# Point BASE_URL at a reachable Ollama endpoint (e.g. a private InstaBox port
# publish). Private port links use a `_token` query parameter: store that token
# in URL_TOKEN, never in BASE_URL. Both are server-side only and never exposed.
REVORA_HOSTED_OLLAMA_ENABLED=false
REVORA_HOSTED_OLLAMA_BASE_URL=
# REVORA_HOSTED_OLLAMA_TOKEN=
# REVORA_HOSTED_OLLAMA_URL_TOKEN=
# REVORA_HOSTED_OLLAMA_DISCOVERY_TIMEOUT_S=5
# REVORA_HOSTED_OLLAMA_CONNECT_TIMEOUT_S=5
# REVORA_HOSTED_OLLAMA_READ_TIMEOUT_S=300
# REVORA_HOSTED_OLLAMA_CACHE_TTL_S=15
# REVORA_HOSTED_OLLAMA_KEEP_ALIVE=5m
# REVORA_HOSTED_OLLAMA_MAX_CONCURRENT_REQUESTS=2
# REVORA_HOSTED_OLLAMA_MAX_CONCURRENT_REQUESTS_PER_MODEL=1
# REVORA_HOSTED_OLLAMA_QUEUE_TIMEOUT_S=30

# Private Whisper-Tiny English speech-to-text for the chat composer.
# One private service owns the model and the single global inference slot;
# the backend only proxies. Both this kill switch AND Admin -> Hosted models
# -> Speech must be on; this switch ships off so a deployment must arm it
# explicitly. BASE_URL/TOKEN are server-side only and are never returned by
# any API or placed in a URL. No audio or transcript is stored.
REVORA_SPEECH_ENABLED=false
REVORA_SPEECH_BASE_URL=
# REVORA_SPEECH_TOKEN=
# REVORA_SPEECH_CONNECT_TIMEOUT_S=5
# REVORA_SPEECH_READ_TIMEOUT_S=300
# REVORA_SPEECH_WRITE_TIMEOUT_S=30
# REVORA_SPEECH_MAX_CONCURRENT_REQUESTS=4
# REVORA_SPEECH_QUEUE_TIMEOUT_S=30
# REVORA_SPEECH_RATE_PER_MINUTE=6
# REVORA_SPEECH_MAX_AUDIO_MB=5
# REVORA_SPEECH_MAX_RECORDING_SECONDS=60

# Hosted machine wake / recovery (optional, off by default).
# Revora only wakes the machine and holds an activity lease; it never changes
# the remote Ollama binding. The API key is server-side only, never exposed.
REVORA_HOSTED_WAKE_ENABLED=false
REVORA_HOSTED_WAKE_API_BASE_URL=
REVORA_HOSTED_WAKE_MACHINE_ID=
# REVORA_HOSTED_WAKE_API_KEY=
# REVORA_HOSTED_WAKE_TIMEOUT_S=60
# REVORA_HOSTED_READY_TIMEOUT_S=120
# REVORA_HOSTED_LEASE_TTL_S=600

# Session-aware monitoring: probes hosted Ollama while an authenticated,
# recently-active dashboard session exists and wakes the machine when needed.
# Wake is deduplicated across users/workers (Redis when available, DB fallback).
# Monitoring never holds a machine-awake lease, so the machine still idles.
# REVORA_HOSTED_MONITOR_ENABLED=true
# REVORA_HOSTED_MONITOR_INTERVAL_S=20
# REVORA_HOSTED_READY_POLL_INTERVAL_S=0.5
# REVORA_HOSTED_WAKE_COOLDOWN_S=300
